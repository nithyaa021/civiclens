# ------------------------------------------------------------------
# CivicLens AI - environment configuration
# Copy to `.env` and adjust values for your machine.
# ------------------------------------------------------------------

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- MongoDB -------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=civiclens

# --- Redis (Celery broker + result backend + rate limiting) -------
REDIS_URL=redis://localhost:6379/0

# --- JWT -----------------------------------------------------------
# MUST be a long random string in production (>= 32 chars).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Public demo ---------------------------------------------------
# The console opens without a login form: it silently enters a seeded demo
# perspective and visitors switch views from the header. Sessions are normal
# short-lived tokens for the seeded @civiclens.dev accounts, so RBAC and ward
# scoping still apply. Set to false to require credentials instead.
DEMO_MODE=true

# --- Rate limiting -------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
# Auth, demo-session, logout and refresh are limited more aggressively per IP.
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# --- CORS (JSON array of origins) ----------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# --- Optional SMTP (notifications fall back to DB-only when empty) -
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@civiclens.local

# --- Phase 2: vector search (Qdrant + multilingual embeddings) -----
# Empty QDRANT_URL => embedded on-disk mode at QDRANT_PATH (single process).
# In docker-compose this is set to http://qdrant:6333.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=var/qdrant
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
SIMILAR_MIN_SCORE=0.85
SIMILAR_GEO_RADIUS_KM=0.2
SIMILAR_TOP_K=8

# --- Phase 2: speech-to-text + translation -------------------------
WHISPER_MODEL=small
TRANSLATION_MODEL=Xenova/nllb-200-distilled-600M
# Local ONNX cache populated by scripts/warmup_models.py (falls back to HF cache).
TRANSLATION_LOCAL_DIR=var/models/nllb
TRANSLATION_TARGET_LANG=eng_Latn
TRANSLATION_MAX_TOKENS=160
LANGUAGE_MIN_CONFIDENCE=0.5

# --- Phase 2: recurring-issue clustering (DBSCAN) ------------------
CLUSTER_LOOKBACK_DAYS=60
CLUSTER_EPS=0.6
CLUSTER_MIN_SAMPLES=3
CLUSTER_GEO_SCALE_KM=1.0
CLUSTER_GEO_WEIGHT=1.0
CLUSTER_SEMANTIC_WEIGHT=1.0

# --- Phase 2: priority scoring (weights must sum to 1.0) -----------
PRIORITY_SENSITIVE_RADIUS_KM=1.0
PRIORITY_MAX_AGE_DAYS=30
PRIORITY_RECOMPUTE_INTERVAL_MINUTES=30

# --- Phase 2: SLA + escalation -------------------------------------
SLA_DEFAULT_TARGET_HOURS=72
ESCALATION_LADDER=["city","command"]
SLA_CHECK_INTERVAL_MINUTES=15

# --- Phase 2: resolution verification + forecasting ----------------
RESOLUTION_MODEL_PATH=var/models/resolution_comparator.joblib
RESOLUTION_PASS_THRESHOLD=0.60
FORECAST_MODEL_PATH=var/models/forecast_xgb.joblib
FORECAST_HORIZON_DAYS=14
FORECAST_MIN_HISTORY_DAYS=28

# --- Phase 2: grounded assistant + media storage -------------------
ASSISTANT_MIN_SCORE=0.45
ASSISTANT_TOP_EXAMPLES=3
ASSISTANT_MAX_CITATIONS=20
MEDIA_DIR=var/media
MODELS_DIR=var/models

