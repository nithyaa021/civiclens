# ------------------------------------------------------------------
# CivicLens AI - Oracle Always Free production environment
#
# Copy with `./generate-env.sh <api-domain> <cors-origin> [acme-email]`
# instead of editing the generated secrets by hand.  The file contains
# credentials and must never be committed.
# ------------------------------------------------------------------

ENVIRONMENT=production
LOG_LEVEL=INFO

# --- MongoDB -------------------------------------------------------
MONGO_DB=civiclens
MONGO_ROOT_USER=civiclens
MONGO_ROOT_PASSWORD=replace-with-openssl-rand-hex-24

# --- Redis (Celery broker + result backend + rate limiting) -------
REDIS_PASSWORD=replace-with-openssl-rand-hex-24

# --- Qdrant (internal service; API key still required) -------------
QDRANT_API_KEY=replace-with-openssl-rand-hex-24

# --- JWT -----------------------------------------------------------
JWT_SECRET=replace-with-openssl-rand-hex-48
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Public origin + TLS -------------------------------------------
# API_DOMAIN must be a hostname without a scheme.  sslip.io resolves every
# subdomain to the embedded IPv4 address, so no DNS account is needed.
API_DOMAIN=api.203.0.113.10.sslip.io
ACME_EMAIL=admin@example.com
# JSON array.  Include the exact Vercel production origin(s), no trailing slash.
CORS_ORIGINS=["https://civiclens.vercel.app"]

# --- Rate limiting -------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# --- Optional SMTP (DB-only notifications when empty) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@civiclens.local

# --- Phase 2: embeddings / vector search ---------------------------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
SIMILAR_MIN_SCORE=0.85
SIMILAR_GEO_RADIUS_KM=0.2
SIMILAR_TOP_K=8

# --- Phase 2: speech-to-text + translation -------------------------
WHISPER_MODEL=small
TRANSLATION_MODEL=Xenova/nllb-200-distilled-600M
TRANSLATION_LOCAL_DIR=var/models/nllb
TRANSLATION_TARGET_LANG=eng_Latn
TRANSLATION_MAX_TOKENS=160
LANGUAGE_MIN_CONFIDENCE=0.5

# --- Phase 2: recurring-issue clustering ---------------------------
CLUSTER_LOOKBACK_DAYS=60
CLUSTER_EPS=0.6
CLUSTER_MIN_SAMPLES=3
CLUSTER_GEO_SCALE_KM=1.0
CLUSTER_GEO_WEIGHT=1.0
CLUSTER_SEMANTIC_WEIGHT=1.0

# --- Phase 2: priority scoring (weights must sum to 1.0) -----------
PRIORITY_SENSITIVE_RADIUS_KM=1.0
PRIORITY_MAX_AGE_DAYS=30
PRIORITY_RECOMPUTE_INTERVAL_MINUTES=30

# --- Phase 2: SLA + escalation -------------------------------------
SLA_DEFAULT_TARGET_HOURS=72
ESCALATION_LADDER=["city","command"]
SLA_CHECK_INTERVAL_MINUTES=15

# --- Phase 2: resolution verification + forecasting ----------------
RESOLUTION_MODEL_PATH=var/models/resolution_comparator.joblib
RESOLUTION_PASS_THRESHOLD=0.60
FORECAST_MODEL_PATH=var/models/forecast_xgb.joblib
FORECAST_HORIZON_DAYS=14
FORECAST_MIN_HISTORY_DAYS=28

# --- Grounded assistant + storage paths ----------------------------
ASSISTANT_MIN_SCORE=0.45
ASSISTANT_TOP_EXAMPLES=3
ASSISTANT_MAX_CITATIONS=20
MEDIA_DIR=var/media
MODELS_DIR=var/models

# Keep ONNX runtimes from oversubscribing the four vCPUs.  Raise to 4 on a
# larger VM if translation latency matters more than tail stability.
OMP_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
